{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spendly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yassinebenzriouil.spendly",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "ar"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yassinebenzriouil.spendly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/logo-dark.png",
            "backgroundColor": "#11130F"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpaceGrotesk-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Spendly uses the camera to take a photo of a receipt and keep it with the expense, on this phone only.",
          "photosPermission": "Spendly opens your photos so you can attach a receipt to an expense. Photos stay on this phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Spendly uses Face ID to unlock the app when App lock is on."
        }
      ],
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/SpaceGrotesk-SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "Spendly",
              "description": "Today's spending. Tap to add an expense.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withQuickLogTile",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2894977a-6658-4ac4-bbbd-9f1ec26264df"
      }
    },
    "locales": {
      "ar": "./assets/locales/ar.json"
    }
  }
}
